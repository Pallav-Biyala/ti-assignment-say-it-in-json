{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipelineforge.example.invalid/schemas/pfcfg-json-v1.schema.json",
  "title": "pfcfg-json/v1",
  "description": "JSON representation of PipelineForge .pfcfg configuration files. An ordered-statement AST format that preserves includes, conditionals, assignments, and typed interpolation nodes for independent evaluation.",
  "type": "object",
  "required": ["format", "source", "body"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pfcfg-json/v1"
    },
    "source": {
      "type": "string",
      "description": "Repository-relative path to the originating .pfcfg file. Informational; not used for includes.",
      "minLength": 1
    },
    "body": {
      "type": "array",
      "items": { "$ref": "#/$defs/Stmt" }
    }
  },
  "$defs": {
    "Value": {
      "oneOf": [
        { "$ref": "#/$defs/LiteralValue" },
        { "$ref": "#/$defs/EnvValue" },
        { "$ref": "#/$defs/EnvDefaultValue" },
        { "$ref": "#/$defs/EnvAlternateValue" },
        { "$ref": "#/$defs/RefValue" },
        { "$ref": "#/$defs/ConcatValue" }
      ]
    },
    "LiteralValue": {
      "type": "object",
      "required": ["lit"],
      "additionalProperties": false,
      "properties": {
        "lit": {
          "type": "string",
          "description": "A literal string. Booleans, numbers, and comma-separated lists remain strings in v1."
        }
      }
    },
    "EnvValue": {
      "type": "object",
      "required": ["env"],
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "string",
          "description": "Name of the environment variable to look up. Unset or empty -> empty string.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "EnvDefaultValue": {
      "type": "object",
      "required": ["env", "default"],
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "default": { "$ref": "#/$defs/Value" }
      }
    },
    "EnvAlternateValue": {
      "type": "object",
      "required": ["env", "alternate"],
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "alternate": { "$ref": "#/$defs/Value" }
      }
    },
    "RefValue": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "object",
          "required": ["section", "key"],
          "additionalProperties": false,
          "properties": {
            "section": {
              "type": "string",
              "description": "Dotted section path, e.g. 'toolchain.node' or 'build'.",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ConcatValue": {
      "type": "object",
      "required": ["concat"],
      "additionalProperties": false,
      "properties": {
        "concat": {
          "type": "array",
          "items": { "$ref": "#/$defs/Value" },
          "minItems": 1
        }
      }
    },
    "Stmt": {
      "oneOf": [
        { "$ref": "#/$defs/IncludeStmt" },
        { "$ref": "#/$defs/IncludeOnceStmt" },
        { "$ref": "#/$defs/IfdefStmt" },
        { "$ref": "#/$defs/IfndefStmt" },
        { "$ref": "#/$defs/SetStmt" }
      ]
    },
    "IncludeStmt": {
      "type": "object",
      "required": ["op", "path"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "include" },
        "path": {
          "type": "string",
          "description": "Path to another pfcfg-json/v1 .json file, relative to the directory of the containing file.",
          "minLength": 1
        }
      }
    },
    "IncludeOnceStmt": {
      "type": "object",
      "required": ["op", "path"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "include_once" },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "IfdefStmt": {
      "type": "object",
      "required": ["op", "var", "body"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "ifdef" },
        "var": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/Stmt" }
        }
      }
    },
    "IfndefStmt": {
      "type": "object",
      "required": ["op", "var", "body"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "ifndef" },
        "var": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/Stmt" }
        }
      }
    },
    "SetStmt": {
      "type": "object",
      "required": ["op", "section", "key", "value"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "set" },
        "section": {
          "type": "string",
          "description": "Section name. May contain dots (dotted section paths).",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": { "$ref": "#/$defs/Value" }
      }
    }
  }
}

# Initech — secrets (never commit real values; env-only)

@ifdef VAULT_ADDR
[secrets]
provider = vault
path = ${VAULT_SECRET_PATH:-initech/ci}
@endif

@ifndef VAULT_ADDR
[secrets]
provider = env
prefix = INITECH_
@endif

[signing]
; REQUIRED_SIGNING_SECRET must be set in production — no default
key_material = ${REQUIRED_SIGNING_SECRET}

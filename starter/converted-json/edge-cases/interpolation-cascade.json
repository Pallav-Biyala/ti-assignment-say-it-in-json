      "path": "../_base/defaults.pfcfg"
    },
    {
      "op": "set",
      "section": "cascade",
      "key": "alpha",
      "value": {
        "env": "CASCADE_ALPHA",
        "default": {
          "lit": "unset"
        }
      }
    },
    {
      "op": "set",
      "section": "cascade",
      "key": "beta",
      "value": {
        "concat": [
          {
            "lit": "prefix-"
          },
          {
            "ref": {
              "section": "cascade",
              "key": "alpha"
            }
          },
          {
            "lit": "-suffix"
          }
        ]
      }
    },
    {
      "op": "set",
      "section": "cascade",
      "key": "gamma",
      "value": {
        "env": "CASCADE_GAMMA",
        "default": {

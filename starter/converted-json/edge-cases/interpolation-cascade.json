            "section": "cascade",
            "key": "beta"
          }
        }
      }
    },
    {
      "op": "set",
      "section": "cascade",
      "key": "delta",
      "value": {
        "env": "CASCADE_DELTA",
        "default": {
          "concat": [
            {
              "ref": {
                "section": "cascade",
                "key": "gamma"
              }
            },
            {
              "lit": "-final"
            }
          ]
        }
      }
    },
    {
      "op": "set",
      "section": "cascade",
      "key": "epsilon",
      "value": {
        "concat": [
          {
            "lit": "local-"
          },
          {
            "ref": {
              "section": "cascade",
              "key": "delta"
            }
          }
        ]
      }
    },
    {
      "op": "ifdef",
      "var": "CI",
      "body": [
        {
          "op": "set",
          "section": "cascade",
          "key": "epsilon",
          "value": {
            "concat": [
              {
                "lit": "ci-"
              },
              {
                "ref": {
                  "section": "cascade",
                  "key": "delta"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "op": "set",
      "section": "cascade.loop",
      "key": "a",
      "value": {
        "ref": {
          "section": "cascade.loop",
          "key": "b"
        }
      }
    },
    {
      "op": "set",
      "section": "cascade.loop",
      "key": "b",
      "value": {
        "ref": {
          "section": "cascade.loop",
          "key": "a"
        }
      }
    }
  ]

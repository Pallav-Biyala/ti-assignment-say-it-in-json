{
  "format": "pfcfg-json/v1",
  "source": "/media/sf_Linux/ti-assignment-say-it-in-json/starter/configs/customers/initech/secrets.pfcfg",
  "body": [
    {
      "op": "ifdef",
      "var": "VAULT_ADDR",
      "body": [
        {
          "op": "set",
          "section": "secrets",
          "key": "provider",
          "value": {
            "lit": "vault"
          }
        },
        {
          "op": "set",
          "section": "secrets",
          "key": "path",
          "value": {
            "env": "VAULT_SECRET_PATH",
            "default": {
              "lit": "initech/ci"
            }
          }
        }
      ]
    },
    {
      "op": "ifndef",
      "var": "VAULT_ADDR",
      "body": [
        {
          "op": "set",
          "section": "secrets",
          "key": "provider",
          "value": {
            "lit": "env"
          }
        },
        {
          "op": "set",
          "section": "secrets",
          "key": "prefix",
          "value": {
            "lit": "INITECH_"
          }
        }
      ]
    },
    {
      "op": "set",
      "section": "signing",
      "key": "key_material",
      "value": {
        "env": "REQUIRED_SIGNING_SECRET"
      }
    }
  ]
}
